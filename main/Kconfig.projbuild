menu "App Configuration"

    config CONSOLE_MAX_COMMAND_LINE_LENGTH
        int "Maximum command line length"
        default 1024
        help
            Maximum length of a single console command line.

    config APP_BLE_DEVICE_NAME
        string "BLE device name"
        default "TempChart-S3"
        help
            GAP device name advertised over BLE (NimBLE bleprph style).

    config APP_OTA_FIRMWARE_URL
        string "OTA firmware HTTPS URL"
        default "https://192.168.1.100:8070/11_Fac.bin"
        help
            URL of the firmware binary on your OTA server.
            Use the same CA cert as server_certs/ca_cert.pem for HTTPS.

    config APP_OTA_RECV_TIMEOUT
        int "OTA receive timeout (ms)"
        default 10000
        help
            HTTP receive timeout for OTA download.

endmenu
